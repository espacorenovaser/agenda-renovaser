rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validRole() {
      return request.resource.data.role in ['admin', 'terapeuta'];
    }

    // Perfil e Usuários/Profissionais da Equipe
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && validRole()
        && ((request.auth.uid == userId && request.resource.data.role == 'terapeuta') || isAdmin());
      allow update: if (isOwner(userId) || isAdmin()) && validRole()
        && (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();

      match /chat_messages/{messageId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /meeting_logs/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Coleção Compartilhada de Agendamentos e Reuniões
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && (isAdmin() || request.resource.data.therapistId == request.auth.uid);
      allow delete: if isSignedIn()
        && (isAdmin() || resource.data.therapistId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}