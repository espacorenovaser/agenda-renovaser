# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Chave para chamadas de IA via OpenAI (GPT-4o / GPT-4o-mini).
# Pode ser usada em conjunto com o Gemini (fallback automático) ou como provedor principal.
# Adicione no painel de Segredos/Settings do AI Studio ou nas variáveis de ambiente da Vercel.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# AI_PROVIDER: Provedor preferencial: 'auto' (padrão com fallback inteligente), 'gemini' ou 'openai'
AI_PROVIDER="auto"

# OPENAI_MODEL: Modelo OpenAI a ser utilizado (padrão: gpt-4o-mini ou gpt-4o)
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
