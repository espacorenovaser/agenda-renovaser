# ==========================================
# SUPABASE CONFIGURATION (Obrigatório)
# ==========================================
# Obtenha essas chaves em https://supabase.com/dashboard
# 1. Acesse seu projeto Supabase
# 2. Vá em Settings > API
# 3. Copie a URL do projeto e a chave anonínima (Anon key)

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ==========================================
# ENVIRONMENT & SERVER CONFIGURATION
# ==========================================
# Ambiente de execução: development, staging, production
NODE_ENV=development

# Porta do servidor Node.js (padrão: 5000)
PORT=5000

# ==========================================
# APPLICATION SETTINGS
# ==========================================
# URL base da aplicação (usada para links, webhooks, etc)
VITE_APP_URL=http://localhost:5173

# ==========================================
# OPTIONAL: EXTERNAL INTEGRATIONS
# ==========================================
# Adicione aqui chaves de APIs externas conforme necessário
# Exemplos (descomente e preencha conforme necessário):

# Google Calendar API (opcional)
# VITE_GOOGLE_CALENDAR_API_KEY=your_api_key_here

# SendGrid para e-mails (opcional)
# VITE_SENDGRID_API_KEY=your_sendgrid_key_here

# WhatsApp Business API (opcional)
# VITE_WHATSAPP_API_KEY=your_whatsapp_key_here
# VITE_WHATSAPP_PHONE_ID=your_phone_id_here

# Stripe para pagamentos (opcional)
# VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here
# VITE_STRIPE_SECRET_KEY=your_stripe_secret_key_here

# ==========================================
# NOTES / INSTRUÇÕES
# ==========================================
# • NÃO commite arquivos .env com valores reais
# • Use este arquivo como template (.env.example)
# • Crie um arquivo .env local com seus valores
# • Mantenha senhas e chaves privadas seguras
# • Para produção, use variáveis de ambiente do seu host (Vercel, Railway, etc)
