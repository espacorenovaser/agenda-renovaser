{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and agenda preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "timeZone": { "type": "string" },
        "defaultMeetingDurationMinutes": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "timeZone", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message in conversation history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "role", "content", "createdAt"]
    },
    "MeetingLog": {
      "title": "MeetingLog",
      "description": "Stores meeting audit events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "eventId": { "type": "string" },
        "title": { "type": "string" },
        "startDateTime": { "type": "string" },
        "endDateTime": { "type": "string" },
        "action": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "action", "createdAt"]
    },
    "Evento": {
      "title": "Evento",
      "description": "Compromisso, atendimento ou evento da agenda",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["atendimento", "reuniao", "evento"] },
        "time": { "type": "string" },
        "date": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string", "enum": ["presencial", "online"] },
        "therapistId": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientWhatsApp": { "type": "string" },
        "badgeColor": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "category", "time", "date", "location", "type", "therapistId"]
    },
    "TherapistUser": {
      "title": "TherapistUser",
      "description": "Membro ou profissional/administrador do Instituto RenovaSer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "terapeuta"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "TherapistUser",
      "description": "Stores user preferences, therapists and administrators"
    },
    "/users/{userId}/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Stores conversation messages for the user"
    },
    "/users/{userId}/meeting_logs/{logId}": {
      "schema": "MeetingLog",
      "description": "Stores meeting audit events"
    },
    "/events/{eventId}": {
      "schema": "Evento",
      "description": "Stores appointments, meetings and events"
    }
  }
}
